{
  "name": "tpms-studio-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "TPMS Studio Electron engineering workbench",
  "main": "main.cjs",
  "scripts": {
    "start": "node start.cjs",
    "build": "vite build",
    "build:web": "node ../scripts/build_web.mjs",
    "test": "node --test tests/bridge.test.cjs tests/node-graph.test.cjs tests/node-optimization.test.cjs tests/inspection.test.cjs tests/workflow-drag.test.cjs tests/display-geometry.test.cjs tests/primitive-catalog.test.cjs tests/solid-operations.test.cjs",
    "verify-operations": "node tests/operations-ui.cjs",
    "verify-inspection": "node tests/inspection-ui.cjs",
    "verify-edge-quality": "node tests/edge-quality-ui.cjs",
    "verify-primitives": "node tests/primitive-ui.cjs",
    "verify-web": "node tests/web-viewer-ui.cjs",
    "verify-node-optimization": "node tests/node-optimization.cjs",
    "verify-workflow-layout": "node tests/workflow-layout.cjs",
    "verify-notebook-cards": "node tests/notebook-cards.cjs",
    "verify-multi-entity": "node tests/multi-entity-ui.cjs",
    "verify-workflow-navigation": "node tests/workflow-navigation.cjs",
    "verify-ribbon": "node tests/ribbon-ui.cjs",
    "verify-workflow-drag": "node tests/workflow-drag-ui.cjs",
    "verify-nodes": "node tests/node-workflow.cjs",
    "verify-ui": "node tests/ui-smoke.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "playwright": "^1.58.0",
    "vite": "^7.3.0"
  }
}
